{
  "compilerOptions": {
    // 输出语法目标；ES2022 适合当前现代浏览器，并支持 Vitest 类型里的私有字段。
    "target": "ES2022",
    // 浏览器项目可用的标准库类型定义。
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // 使用现代 ES 模块；Bundler 模式按 Vite 的模块解析规则查找依赖。
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // class 字段语义与标准 JavaScript 保持一致。
    "useDefineForClassFields": true,
    // Vue 单文件组件的 JSX 保留给 Vue 工具链处理。
    "jsx": "preserve",
    // 允许导入 JSON 文件。
    "resolveJsonModule": true,
    // 每个文件可独立转译，适配 Vite/esbuild。
    "isolatedModules": true,
    // 保留 import type 等显式类型导入语义。
    "verbatimModuleSyntax": true,
    // 与 CommonJS 依赖交互时允许兼容导入写法。
    "esModuleInterop": true,
    // 跳过第三方 .d.ts 内部检查，仍会检查本项目代码。
    "skipLibCheck": true,
    // 路径别名根目录；配合 paths 将 @/ 映射到 src/。
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    // 开启严格类型检查。
    "strict": true,
    // 不允许声明后未使用的局部变量或参数。
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Vite 负责转译输出，vue-tsc 只做检查，不向 src 写出 JS 文件。
    "noEmit": true,
    // 浏览器端全局类型来源；Vite 的 ImportMeta 类型也在此提供。
    "types": ["vite/client"],
    // 增量编译状态文件位置，避免散落在源码目录。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  // 纳入 Vue、TS 源码和全局类型声明。
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/types/**/*.d.ts"],
  // 测试由 Vitest 执行；不纳入应用类型项目构建。
  "exclude": ["src/**/__tests__/*"]
}
